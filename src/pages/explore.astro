---
import Layout from '@/layouts/Layout.astro';
import { SearchBar } from '@/components/search-bar';
import { ExploreFilters } from '@/components/explore-filters';
---

<Layout 
  title="Explore Units | Bayou Boxables"
  description="Browse our unique converted shipping container homes in Covington, LA. Find the perfect rustic-industrial retreat for your bayou adventure."
>
  <main class="min-h-screen bg-background">
    {/* Hero Section with Search */}
    <section class="bg-primary text-primary-foreground py-12 md:py-16">
      <div class="container mx-auto px-4">
        <h1 class="font-raleway text-4xl md:text-5xl font-bold mb-4 text-center text-balance">
          Explore Our Container Homes
        </h1>
        <p class="text-lg text-center mb-8 text-balance max-w-2xl mx-auto opacity-90">
          Find the perfect rustic-industrial retreat for your bayou adventure
        </p>
        <SearchBar client:load />
      </div>
    </section>

    {/* Main Content */}
    <section class="py-12">
      <div class="container mx-auto px-4">
        <ExploreFilters client:load />
      </div>
    </section>
  </main>
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { ContactForm } from '@/components/contact-form';
import { Mail, Phone, MapPin, Clock } from 'lucide-react';
---

<Layout 
  title="Contact Us | Bayou Boxables"
  description="Get in touch with Bayou Boxables. We're here to help make your bayou experience unforgettable."
>
  <main class="min-h-screen bg-background py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        {/* Header */}
        <div class="text-center mb-12">
          <h1 class="font-serif text-4xl md:text-5xl font-bold mb-4">Get in Touch</h1>
          <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
            Have questions about your stay? We're here to help make your bayou experience unforgettable.
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          {/* Contact Information */}
          <div class="lg:col-span-1 space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Contact Information</CardTitle>
                <CardDescription>Reach out to us directly</CardDescription>
              </CardHeader>
              <CardContent className="space-y-4">
                <div class="flex items-start gap-3">
                  <Mail className="h-5 w-5 text-primary mt-1 shrink-0" />
                  <div>
                    <p class="font-semibold mb-1">Email</p>
                    <a href="mailto:stay@bayouboxables.com" class="text-muted-foreground hover:text-primary">
                      stay@bayouboxables.com
                    </a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Phone className="h-5 w-5 text-primary mt-1 shrink-0" />
                  <div>
                    <p class="font-semibold mb-1">Phone</p>
                    <a href="tel:+15551234567" class="text-muted-foreground hover:text-primary">
                      (555) 123-4567
                    </a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <MapPin className="h-5 w-5 text-primary mt-1 shrink-0" />
                  <div>
                    <p class="font-semibold mb-1">Location</p>
                    <p class="text-muted-foreground">
                      Covington, Louisiana<br />1 hour from New Orleans
                    </p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Clock className="h-5 w-5 text-primary mt-1 shrink-0" />
                  <div>
                    <p class="font-semibold mb-1">Response Time</p>
                    <p class="text-muted-foreground">We typically respond within 24 hours</p>
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>Check-In Information</CardTitle>
              </CardHeader>
              <CardContent className="space-y-2 text-sm">
                <div>
                  <p class="font-semibold">Check-in:</p>
                  <p class="text-muted-foreground">After 3:00 PM</p>
                </div>
                <div>
                  <p class="font-semibold">Check-out:</p>
                  <p class="text-muted-foreground">Before 11:00 AM</p>
                </div>
                <div class="pt-2 border-t">
                  <p class="text-muted-foreground">
                    Access codes and detailed directions will be sent 24 hours before your arrival.
                  </p>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Contact Form */}
          <div class="lg:col-span-2">
            <Card>
              <CardHeader>
                <CardTitle>Send Us a Message</CardTitle>
                <CardDescription>Fill out the form below and we'll get back to you soon</CardDescription>
              </CardHeader>
              <CardContent>
                <ContactForm client:load />
              </CardContent>
            </Card>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

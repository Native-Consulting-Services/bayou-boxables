---
import Layout from '@/layouts/Layout.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Rocket } from 'lucide-react';
---

<Layout 
  title="My Account | Bayou Boxables"
  description="Manage your Bayou Boxables bookings and profile."
>
  <main class="min-h-screen bg-background py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <Card>
          <CardContent className="pt-12 pb-12 text-center">
            <div class="flex justify-center mb-6">
              <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-secondary/20">
                <Rocket className="h-10 w-10 text-secondary" />
              </div>
            </div>
            <h1 class="font-serif text-3xl font-bold mb-4">Account Management Coming Soon!</h1>
            <p class="text-lg text-muted-foreground mb-8 leading-relaxed max-w-md mx-auto">
              User accounts and booking management will be available once we launch officially. We're currently seeking investors to bring this unique bayou experience to life.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <Button variant="default" size="lg">
                <a href="/invest">Learn About Investment Opportunities</a>
              </Button>
              <Button variant="outline" size="lg">
                <a href="/explore">Browse Units</a>
              </Button>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </main>
</Layout>
